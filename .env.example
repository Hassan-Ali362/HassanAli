# ---------------------------------------------------------------------------
# Contact form. Copy this file to .env.local and fill in the three values.
#
# Until RESEND_API_KEY and CONTACT_FROM_EMAIL are both set, the form validates
# and then tells the visitor to email directly instead of showing a success
# state for a message that went nowhere. That is deliberate: the form never
# pretends to send.
# ---------------------------------------------------------------------------

# https://resend.com/api-keys
RESEND_API_KEY=

# The sender. Must be an address on a domain you have verified with Resend, so
# your own Gmail will not work here. Resend's onboarding@resend.dev works for
# local testing but only delivers to the account owner's address.
CONTACT_FROM_EMAIL="Portfolio <hello@yourdomain.com>"

# Where messages land. Falls back to profile.email in lib/data.ts if unset.
CONTACT_TO_EMAIL=
